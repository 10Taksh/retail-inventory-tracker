# Copied to /etc/retail-inventory.env by deploy/setup.sh. Keep it readable by root only.

# Required for invoice extraction. Get one at https://aistudio.google.com/apikey,
# then: sudo nano /etc/retail-inventory.env && sudo systemctl restart retail-inventory
GEMINI_API_KEY=

# Optional override; default is gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Data lives outside the git checkout so redeploys never touch it.
DATABASE_PATH=/var/lib/retail-inventory/inventory.db
INVOICES_DIR=/var/lib/retail-inventory/invoices
